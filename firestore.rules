rules_version = '2';
// Lásd docs/spec-v1.md "Security Rules". Változtatás = spec frissítése.
// Ez a fájl a mrashub projekt EGYETLEN telepített Firestore-szabálya: a Quiz of the Damned
// (D:/dev/QotD), a Writing Review (D:/dev/writing-review) és a Hubbaloo (D:/dev/Hubbaloo) blokkja is ide kerül. A játék repójából NEM szabad Firestore-szabályt telepíteni.
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in get(/databases/$(db)/documents/settings/admins).data.emails;
    }

    match /products/{id} {
      allow read: if resource.data.status == 'live' || isAdmin();
      allow write: if isAdmin();
    }
    match /settings/site {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/admins {
      allow read, write: if isAdmin();
    }
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(
        ['email','source','productId','consent','createdAt']) &&
        request.resource.data.consent == true &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.productId is string && request.resource.data.productId.size() <= 60 &&
        request.resource.data.source is string && request.resource.data.source.size() <= 200 &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }
    // users/{uid}: email, displayName, customerId, entitlements, credits, createdAt – csak Cloud Function írja
    // (fizetési központ, admin-callable). A tulajdonosa olvassa, hogy az app tudja, mihez fér hozzá.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // csak Admin SDK (Cloud Function)
    }

    // Kreditmodell (4b, 2026-11-17): a naplót csak Function írja, a saját sorait a felhasználó olvassa.
    match /creditLedger/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false; // csak Admin SDK
    }
    // Árlista és paraméterek: az appok kiírják a művelet árát.
    match /settings/credits {
      allow read: if true;
      allow write: if isAdmin();
    }
    // szamlak (számlázási adat), stripeEvents (webhook-napló), stripeCustomers (ügyfél → uid),
    // ssoCodes (egyszer használható belépőkódok hash-e, 2026-11-20, functions/sso.js): nincs szabály = kliensről se nem olvasható, se nem írható; a szamlak-ot csak admin-callable adja ki.

    // Előfizetés-jogosultság az appok szabályaihoz: az app saját kulcsa VAGY az `all` aktív
    // (ugyanaz a szabály, mint a shared/entitlements.js-ben). Hiányzó dokumentum/mező = nincs;
    // belépés nélkül a kiértékelés hibára fut, ami tiltás.
    function entitled(app) {
      let path = /databases/$(db)/documents/users/$(request.auth.uid);
      let ents = exists(path) ? get(path).data.get('entitlements', {}) : {};
      return ents.get(app, {}).get('status', '') == 'active'
        || ents.get('all', {}).get('status', '') == 'active';
    }

    // ---- Quiz of the Damned ------------------------------------------------------------
    function signedIn() { return request.auth != null; }
    // Teachers sign in with Google or e-mail; players are anonymous.
    function teacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    // Hub pass (hub 4c, 2026-11-19): users/{uid}.entitlements.qotd or .all is active – written by the hub.
    // History and question stats are Hub pass features. (entitled() is the hub's function, above.)
    function pro() { return teacher() && entitled('qotd'); }

    // users/{uid}: lásd fent (a hub része) – a játék csak a sajátját olvassa.

    // Which questions the teacher has already played, per pack (2026-11-12): the projector writes it
    // as questions are shown, the Packs page reads it and resets it. Only lists of question ids.
    match /users/{uid}/usage/{packId} {
      allow read, delete: if teacher() && request.auth.uid == uid;
      allow create, update: if teacher() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['trivia', 'escape', 'shortcut'])
        && (!('trivia' in request.resource.data) || (request.resource.data.trivia is list && request.resource.data.trivia.size() <= 500))
        && (!('escape' in request.resource.data) || (request.resource.data.escape is list && request.resource.data.escape.size() <= 500))
        && (!('shortcut' in request.resource.data) || (request.resource.data.shortcut is list && request.resource.data.shortcut.size() <= 500));
    }

    // Teachers' packs are written only by the functions (savePack, generatePack, deletePack),
    // which validate them. Admins write the built-in ones.
    match /packs/{packId} {
      allow read: if teacher() && (resource.data.owner == request.auth.uid || resource.data.source == 'builtin');
      allow create, update, delete: if admin();

      // Question stats: written by finalizeGame (admin SDK), read by a Pro owner.
      match /qstats/{qId} {
        allow read: if pro() && get(/databases/$(db)/documents/packs/$(packId)).data.owner == request.auth.uid;
      }
    }

    // Fixed content: everyone signed in reads, only admins write.
    match /content/{docId} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /escapeBank/{level} {
      allow read: if teacher();
      allow write: if admin();
    }
    match /narration/{character} {
      allow read: if signedIn();
      allow write: if admin();
    }

    // Played matches: written by finalizeGame, read by the teacher who ran them.
    match /games/{gameId} {
      allow read: if pro() && resource.data.owner == request.auth.uid;
    }
    // ---- end Quiz of the Damned --------------------------------------------------------

    // ---- Writing Review (D:/dev/writing-review, main ág; 4d, 2026-11-17) -------------------
    // A WR repó firestore.rules-ának blokkja (ott az emulátoros tesztek futnak ellene); változás: előbb ott,
    // aztán ide változatlanul (a $(database) helyett $(db)). A tanári szerep a token szerep-claimje
    // (a WR szerepBeallitas / tanariRegisztracio függvénye adja). Gyűjtemények: felhasznalok, feladatok
    // (+elemzes), linkek, csoportok (+diakok, becenevek), rubrikak, beadasok (+ertekeles), ai_hasznalat;
    // csak szerver: tanarok (régi kvóta-adat, már nem írja semmi). A kredit a hub users/creditLedger-e.
    // ── SEGÉDFÜGGVÉNYEK ──

    function belepve() {
      return request.auth != null;
    }

    function sajat(uid) {
      return belepve() && request.auth.uid == uid;
    }

    // A claim hiányát explicit kezeljük, hogy ne dobjon hibát a kiértékelés.
    function tanar() {
      return belepve()
        && 'szerep' in request.auth.token
        && request.auth.token.szerep == 'tanar';
    }

    // Szám vagy null (a szószámhatárok): egy tanár által írt mező a diák felületén
    // jelenik meg, ezért nem lehet benne szöveg/HTML (audit 3. kör).
    function szamVagyNull(v) {
      return v == null || (v is number && v >= 0 && v <= 100000);
    }

    function rubrikaMezokOk(r) {
      return r is map
        && szamVagyNull(r.get('min_szo', null))
        && szamVagyNull(r.get('max_szo', null));
    }

    // A feladatlap: a tanár saját feltöltése, tokenes Storage-letöltési URL-lel
    // (a diák linkként kapja meg: nem lehet javascript: vagy idegen séma).
    function feladatlapOk(f) {
      return f is map
        && f.keys().hasOnly(['path', 'url'])
        && f.path is string
        && f.path.matches('feladatlapok/' + request.auth.uid + '/[^/]+')
        && f.url is string
        && f.url.matches('https://firebasestorage\\.googleapis\\.com/.*');
    }

    // Csak a megadott mezők változhatnak egy update során.
    function csakEzekValtoznak(mezok) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(mezok);
    }

    // ══════════════════════════════════════════
    // FELHASZNÁLÓK
    // ══════════════════════════════════════════
    match /felhasznalok/{uid} {
      allow get: if sajat(uid);

      // Listázni senki nem tud (az admin a felhasznalokListaja Functionön át).
      allow list: if false;

      // Regisztrációkor senki nem tanár ('nincs' = nincs tanári jog; diák
      // szerep 2026-11-12 óta nincs). A szerepet csak a szerver (claim +
      // tükör) állíthatja át.
      // A tanari_kerelem jelzi, hogy a fiók tanári regisztrációval jött létre;
      // ez önmagában NEM ad jogot: a tanariRegisztracio Function ellenőrzi
      // (megerősített e-mail), és csak az állítja át a szerepet.
      // Csak létrehozáskor írható (az update lent nem engedi), így egy
      // kérelem nélküli fiók utólag nem kérhet tanári jogot.
      allow create: if sajat(uid)
        && request.resource.data.szerep == 'nincs'
        && request.resource.data.keys().hasOnly(['nev', 'email', 'szerep', 'letrehozva', 'tanari_kerelem'])
        && (!('tanari_kerelem' in request.resource.data)
            || request.resource.data.tanari_kerelem == true);

      // A nevét átírhatja, a szerepét és az emailjét nem.
      // A tura_* mezők a beépített bemutató állapotát tartják (látott
      // szakaszok, felnyíljon-e magától) – a felhasználó sajátja, de
      // típusban kötött, hogy ne lehessen rajta adatot tárolni.
      allow update: if sajat(uid)
        && csakEzekValtoznak(['nev', 'tura_kesz', 'tura_latott'])
        && (!('tura_kesz' in request.resource.data)
            || request.resource.data.tura_kesz is bool)
        && (!('tura_latott' in request.resource.data)
            || (request.resource.data.tura_latott is list
                && request.resource.data.tura_latott.size() <= 20));

      allow delete: if false;
    }

    // ══════════════════════════════════════════
    // FELADATOK
    // Csak a tanár sajátja (2026-11-12 óta nincs diákfiók és osztály; a diák a
    // feladatleírást a feladatlinken, szerveroldalon kapja meg).
    // ══════════════════════════════════════════
    match /feladatok/{feladatId} {
      allow get: if tanar() && resource.data.tanar_id == request.auth.uid;

      // Tanári lista (tanar_id szűrő).
      allow list: if tanar() && resource.data.tanar_id == request.auth.uid;

      allow create: if tanar()
        && request.resource.data.tanar_id == request.auth.uid
        && !('osztaly_id' in request.resource.data)
        && rubrikaMezokOk(request.resource.data.rubrika)
        && (!('feladatlap' in request.resource.data) || feladatlapOk(request.resource.data.feladatlap))
        && request.resource.data.cim is string
        && request.resource.data.cim.size() > 0
        && request.resource.data.cim.size() <= 200;

      allow update: if tanar()
        && resource.data.tanar_id == request.auth.uid
        && csakEzekValtoznak(['cim', 'aktiv', 'hatarido', 'rubrika', 'feladatlap'])
        && (!('rubrika' in request.resource.data) || rubrikaMezokOk(request.resource.data.rubrika))
        // csak ha a feladatlap változik: a régi (nem szabványos) rekord szerkeszthető marad
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['feladatlap'])
            || feladatlapOk(request.resource.data.feladatlap));

      allow delete: if tanar() && resource.data.tanar_id == request.auth.uid;

      // ── OSZTÁLYSZINTŰ ELEMZÉS ──
      // A feladat maga látható a diákoknak, az elemzés NEM: benne van az
      // osztály teljesítménye és más diákok hibái. Alkollekció, mert a
      // szabályok dokumentum szintjén kapuznak.
      match /elemzes/{docId} {
        allow read: if tanar()
          && get(/databases/$(db)/documents/feladatok/$(feladatId))
               .data.tanar_id == request.auth.uid;

        // Csak a feladatElemzes Function írja
        allow write: if false;
      }
    }

    // ══════════════════════════════════════════
    // FELADATLINKEK (linkek/{a token SHA-256 lenyomata})
    // A tanár a sajátját olvassa (a megosztási oldalon a tokent is: a linket
    // ő osztja meg). Kliensről senki nem írja: a lejáratot, a plafont és a
    // tulajdonost a szerver állítja (linkInditas / linkLezaras). A diák a
    // gyűjtemény közelébe sem jut: a beadás Cloud Functionön át megy.
    // ══════════════════════════════════════════
    match /linkek/{linkId} {
      allow get, list: if tanar() && resource.data.tanar_id == request.auth.uid;
      allow write: if false;
    }

    // ══════════════════════════════════════════
    // CSOPORTOK (8b)
    //
    // A tanár saját csoportjai (pl. „9.B angol”): a feladatlink csoporthoz rendelhető, és a
    // csoport linkjein a becenév a fejlődés-követés kulcsa. Diák-hozzáférés nincs. Kliensről
    // írható (név, archiválás); törölni nem lehet (a linkek és a beadások hivatkoznak rá).
    // ══════════════════════════════════════════
    match /csoportok/{csoportId} {
      function csoportNevOk(n) {
        return n is string && n.size() > 0 && n.size() <= 60;
      }

      allow get, list: if tanar() && resource.data.tanar_id == request.auth.uid;

      allow create: if tanar()
        && request.resource.data.keys().hasOnly(['tanar_id', 'nev', 'aktiv', 'letrehozva'])
        && request.resource.data.tanar_id == request.auth.uid
        && csoportNevOk(request.resource.data.nev)
        && request.resource.data.aktiv == true
        && request.resource.data.letrehozva == request.time;

      allow update: if tanar()
        && resource.data.tanar_id == request.auth.uid
        && csakEzekValtoznak(['nev', 'aktiv'])
        && csoportNevOk(request.resource.data.nev)
        && request.resource.data.aktiv is bool;

      allow delete: if false;

      // ── A CSOPORT DIÁKJAI (8b/2) ──
      // A becenév szerint párosított diákok: a tanár olvassa, írni csak a szerver írja (a beadás,
      // az összevonás és a leválasztás egy tranzakcióban mozgatja a beadásokkal együtt).
      match /diakok/{diakId} {
        allow read: if tanar()
          && get(/databases/$(db)/documents/csoportok/$(csoportId)).data.tanar_id == request.auth.uid;
        allow write: if false;
      }

      // A becenév → diák hozzárendelés: belső, csak a szerver használja.
      match /becenevek/{kulcs} {
        allow read, write: if false;
      }
    }

    // ══════════════════════════════════════════
    // RUBRIKA-SABLONOK
    //
    // A tanár elmentett értékelési rubrikái, hogy ne kelljen minden
    // feladatnál újra összeállítani. Tisztán a tanár sajátja: nincs
    // denormalizálás és nincs diák-hozzáférés, ezért kliensről írható –
    // szemben az osztályokkal vagy a névvel.
    // ══════════════════════════════════════════
    match /rubrikak/{sablonId} {
      allow get: if tanar() && resource.data.tanar_id == request.auth.uid;
      allow list: if tanar() && resource.data.tanar_id == request.auth.uid;

      allow create: if tanar()
        && request.resource.data.tanar_id == request.auth.uid
        && request.resource.data.nev is string
        && request.resource.data.nev.size() > 0
        && request.resource.data.nev.size() <= 100
        && request.resource.data.rubrika is map;

      allow update: if tanar()
        && resource.data.tanar_id == request.auth.uid
        && request.resource.data.tanar_id == resource.data.tanar_id
        && csakEzekValtoznak(['nev', 'rubrika', 'frissitve']);

      allow delete: if tanar() && resource.data.tanar_id == request.auth.uid;
    }

    // ══════════════════════════════════════════
    // BEADÁSOK
    // ══════════════════════════════════════════
    match /beadasok/{beadasId} {
      function beadas() {
        return get(/databases/$(db)/documents/beadasok/$(beadasId)).data;
      }

      allow get, list: if tanar() && resource.data.tanar_id == request.auth.uid;

      // Kliensről nem hozható létre: diákfiók 2026-11-12 óta nincs; a beadás a
      // feladatlinken, Cloud Functionön át jön létre (docs/prod-atalakitas-terv.md).
      allow create: if false;

      // Státuszváltás, javítás, jóváhagyás: mind Cloud Function.
      // Így a diák nem tudja 'elkuldve'-re állítani a saját beadását,
      // és nem tudja újraindítani a javítást sem.
      allow update, delete: if false;

      // ── ÉRTÉKELÉS ──
      match /ertekeles/{docId} {
        // Ez az a pont, amiért az értékelés nem a szülő dokumentumban van:
        // a szabályok nem tudnak mező szintjén szűrni, dokumentum szintjén
        // viszont igen.
        allow get: if tanar() && beadas().tanar_id == request.auth.uid;

        allow list: if tanar() && beadas().tanar_id == request.auth.uid;

        allow write: if false;
      }
    }

    // ══════════════════════════════════════════
    // AI-HASZNÁLAT (mérés)
    // Hívásonkénti tokenszám-napló: csak a szerver írja, és csak az admin
    // látja, összesítve (aiHasznalatJelentes Function). Kliensről elérhetetlen.
    // ══════════════════════════════════════════
    match /ai_hasznalat/{id} {
      allow read, write: if false;
    }
    // ---- end Writing Review --------------------------------------------------------

    // ---- Hubbaloo (D:/dev/Hubbaloo) ---------------------------------------------------
    // Még üres: a hbStories / hbUsage szabályai a Hubbaloo F4–F5 fázisában kerülnek ide
    // (lásd docs/spec-v1.md „Hubbaloo” és a Hubbaloo SPEC.md 9. szakasza).
    // ---- end Hubbaloo -----------------------------------------------------------------
  }
}
